# Vite client env (optional overrides). Copy to `.env` locally — never commit secrets.
#
# Static deploy (Phase 5.1): public site URL is just the host you upload dist/ to.
# There is no VITE_PUBLIC_URL — asset paths are root-relative (`base: '/'`).
# Race packs / EGM96 / fixtures ship inside dist/ from public/. See:
#   docs/ops/hetzner-static-deploy.md
#
# Live telemetry URL resolution (see src/telemetry/README.md):
#   1. Explicit options to startTelemetryIngest
#   2. VITE_WS_URL / VITE_WS_BOAT_URL (non-empty)
#   3. public/config.json wsUrl / wsBoatUrl
#
# HTTPS page ⇒ use wss:// (browsers block mixed content). Local http://localhost may use ws://.
# Phase 5.2 runbook (direct WSS or SPA reverse proxy): docs/ops/wss-live-telemetry.md
# Placeholders only — do not commit production VPS URLs or secrets.
#
# Option A — absolute WSS on telemetry host:
# VITE_WS_URL=wss://example.invalid/stream?client=web&id=drone1
# VITE_WS_BOAT_URL=wss://example.invalid/stream?client=web&id=boat21
#
# Option B — same-origin proxy on SPA host (paths match nginx/Caddy locations):
# VITE_WS_URL=wss://example.invalid/ws/drone
# VITE_WS_BOAT_URL=wss://example.invalid/ws/boat
#
# Local LAN plain WS (http://localhost page only):
# VITE_WS_URL=ws://127.0.0.1:8765/stream?client=web&id=drone1
# VITE_WS_BOAT_URL=ws://127.0.0.1:8765/stream?client=web&id=boat21
VITE_WS_URL=
VITE_WS_BOAT_URL=

# OUT WHEP underlay (Phase 3.3) is configured via public/config.json `whepUrl`, not Vite env.
# Example (local MediaMTX): "http://127.0.0.1:8889/cam1/whep"
# On an HTTPS static host, underlay URL must also be https/WHEP-compatible (no mixed content).
# Leave empty in git; no secrets typical for LAN WHEP.

# Phase 6.4 projects API stub (server/) — see docs/ops/projects-api.md and server/README.md.
# SPA hook is public/config.json `projectsApiBase` (e.g. "/api"), not a Vite env.
# PROJECTS_API_TOKEN=   # if set, POST/PUT/DELETE require Authorization: Bearer <token>
# PROJECTS_API_HOST=127.0.0.1
# PROJECTS_API_PORT=8787
# PROJECTS_DB_PATH=     # default server/data/races.sqlite
# PROJECTS_API_CORS=    # optional, e.g. http://127.0.0.1:5173 when not using Vite proxy
PROJECTS_API_TOKEN=
